{
  "name": "create-pro-stack",
  "version": "1.0.0",
  "description": "Opinionated scaffolding CLI for Next.js and React (Vite) apps with shadcn/ui",
  "type": "module",
  "bin": {
    "create-pro-stack": "./bin/index.js"
  },
  "scripts": {
    "start": "node ./bin/index.js",
    "test": "node --test",
    "test:pack": "npm_config_cache=.npm-cache npm pack --dry-run"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "react",
    "nextjs",
    "vite",
    "scaffold",
    "cli",
    "shadcn-ui",
    "tanstack-query",
    "zustand",
    "redux-toolkit",
    "swr",
    "storybook"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "execa": "^10.0.1",
    "fs-extra": "^11.4.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1"
  }
}
